[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

# List any Python dependencies for the image here
[packages]
# Required by src/trustymail_csv2mongo.py
boto3 = ">=1.42.27"
# Required by src/pshtt_csv2mongo.py, src/sslyze_csv2mongo.py, and
# src/trustymail_csv2mongo.py
mongo_db_from_config = {file = "https://github.com/cisagov/mongo-db-from-config/archive/v1.2.1.tar.gz"}
# Required by src/trustymail_csv2mongo.py
requests = ">=2.32.5"
requests_aws4auth = ">=1.3.1"

# This version should match the version of Python in the image
[requires]
python_full_version = "3.14.3"
